# Droplet settings. The real file lives on the Volume (config/compose.env, mode 660)
# and the checkout's .env is a symlink to it. Never commit the real values.

COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

CONFIG_DIR=/mnt/connectstats_data/config
DATA_DIR=/mnt/connectstats_data
LOG_DIR=/mnt/connectstats_data/log

APP_UID=2000
APP_GID=2000
# app is only reachable through Caddy; the host port is for local debugging.
APP_BIND=127.0.0.1
APP_PORT=8080

INNODB_BUFFER_POOL_SIZE=1536M

MYSQL_ROOT_PASSWORD=change-me
CS_DB_USER=connectstats
CS_DB_PASSWORD=change-me
CS_DATABASES=garmin queue connectstats
# No dev marker on a server: reset_schema() must stay locked.
CS_DEV_MARKER_DB=

SITE_ADDRESSES=new.connectstats.app

# Migration only (docker-compose.migration.yml appended to COMPOSE_FILE until cutover):
# SOURCE_SSH=user@old-droplet
# SOURCE_SSH_KEY=/home/<user>/.ssh/id_ed25519
# SOURCE_SSH_KNOWN_HOSTS=/home/<user>/.ssh/known_hosts

QUEUE_CHECK_INTERVAL=60
# The deployment crontab (CONFIG_DIR is mounted at /etc/connectstats).
CRONTAB=/etc/connectstats/crontab
# healthchecks.io ping key for the scheduled jobs (docker/worker/cronjob.sh). Empty = no pings.
HEALTHCHECKSIO_PING_KEY=
