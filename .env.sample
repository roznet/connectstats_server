# Local development settings: cp .env.sample .env
# On the droplet, .env lives next to the compose file and is not in git.

COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

CONFIG_DIR=./docker/dev
DATA_DIR=./data
LOG_DIR=./data/log

APP_PORT=8080
DB_PORT=3307
INNODB_BUFFER_POOL_SIZE=256M

MYSQL_ROOT_PASSWORD=devroot
CS_DB_USER=connectstats
CS_DB_PASSWORD=devpassword
CS_DATABASES=connectstats_dev connectstats_queue connectstats_bugs
# Allows reset_schema() / `test.py full` on this database. Never set on a server.
CS_DEV_MARKER_DB=connectstats_dev

# Faster queue start in dev.
QUEUE_CHECK_INTERVAL=10
