# TLS front for the droplet (docker-compose.prod.yml). SITE_ADDRESSES is a
# comma-separated list, e.g. "new.connectstats.app" before cutover and
# "connectstats.app, new.connectstats.app" after. Caddy obtains and renews the
# certificates itself (an ACME contact email is optional; add a global `email` if wanted).

{$SITE_ADDRESSES} {
	encode gzip

	# Bug report uploads and FIT files.
	request_body {
		max_size 64MB
	}

	# The API and bug reports: everything the app serves is under /prod.
	# UPSTREAM: app:80 normally; app-test:80 while the Phase 5 test stack is up.
	handle /prod/* {
		reverse_proxy {$UPSTREAM:app:80} {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Everything else: the deployment's own static site, mounted at /srv/site
	# (SITE_DIR in docker-compose.prod.yml): `*.caddy` snippets with its
	# redirects and headers, files under `www/`. Not part of this repo. Without
	# one, these paths are 404.
	handle {
		root * /srv/site/www
		import /srv/site/*.caddy
		file_server
	}

	log {
		output stdout
		format console
	}
}
