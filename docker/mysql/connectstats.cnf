# MySQL settings for ConnectStats. Keep tuning here (in git), never SET PERSIST:
# persisted values live only in the datadir and silently revert if it's rebuilt.
[mysqld]
# innodb_buffer_pool_size is set by the compose `command:` from .env
# (~13 GB of data on a 4 GB droplet: 1.5-2G there; stock default is 128M).
innodb_redo_log_capacity = 536870912

# Replication: the old box is server_id 1. This box is the replica until cutover,
# and keeps binlogs afterwards so a reverse replication (rollback) is possible.
server_id = 2
log_bin = binlog
binlog_expire_logs_seconds = 1209600
# Old box writes ~0.3 GB of binlog a day (9.4 GB over 30 days, 2026-11-01); zstd
# compression cuts that a few times over, and replicas read compressed binlogs.
binlog_transaction_compression = ON

character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

slow_query_log = ON
long_query_time = 2
